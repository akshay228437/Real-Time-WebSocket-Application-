<mxfile host="Electron">
  <diagram name="CICD Flow" id="cicd1">
    <mxGraphModel dx="1579" dy="695" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dev" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Developer&#xa;(git push origin main)" vertex="1">
          <mxGeometry height="60" width="200" x="330" y="40" as="geometry" />
        </mxCell>
        <mxCell id="github" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="GitHub Repository&#xa;(main branch)" vertex="1">
          <mxGeometry height="60" width="200" x="330" y="150" as="geometry" />
        </mxCell>
        <mxCell id="actions" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="GitHub Actions&#xa;Workflow Triggered&#xa;(.github/workflows/deploy.yml)" vertex="1">
          <mxGeometry height="70" width="240" x="310" y="260" as="geometry" />
        </mxCell>
        <mxCell id="ssh" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="SSH into Production Server&#xa;(using SERVER_HOST, SERVER_USER,&#xa;SSH_PRIVATE_KEY secrets)" vertex="1">
