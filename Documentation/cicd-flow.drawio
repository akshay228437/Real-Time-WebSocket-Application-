        </mxCell>
        <mxCell id="serverbox" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontStyle=1" value="On the Server" vertex="1">
          <mxGeometry height="360" width="400" x="230" y="500" as="geometry" />
        </mxCell>
        <mxCell id="gitpull" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="git pull origin main&#xa;(fetch latest code)" vertex="1">
          <mxGeometry height="60" width="300" x="280" y="550" as="geometry" />
        </mxCell>
        <mxCell id="down" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="docker-compose down&#xa;(stop old containers)" vertex="1">
          <mxGeometry height="60" width="300" x="280" y="640" as="geometry" />
        </mxCell>
        <mxCell id="up" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="docker-compose up -d --build&#xa;(rebuild &amp; start containers)" vertex="1">
          <mxGeometry height="60" width="300" x="280" y="730" as="geometry" />
        </mxCell>
        <mxCell id="live" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0b8299;" value="Live App Updated&#xa;http://3.108.58.172/" vertex="1">
          <mxGeometry height="60" width="200" x="330" y="900" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="dev" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="github">
